GeographyObj::getSupervisor(). Many map objects declare both a virtual
getSupervisor() override with a covariant return type and a static
getSupervisor() of the same name, which MWCC accepts and clang rejects.
On the host the virtual slot is getSupervisorVirtual(), and the base
class's non-virtual getSupervisor() forwards to it, so callers and the
static accessors keep working. GeoRabbitMark.h also befriends Race2D and
MapObjPoihana.h declares TPathWalkNode::update() with its real return
type (s16), which the definition uses.

--- a/include/Sato/GeographyObj.h
+++ b/include/Sato/GeographyObj.h
@@ -242,7 +242,13 @@
     virtual void createBoundsSphere(J3DModelData *);                                                // 58
     virtual GeoAnmTableEntry *getAnmTbl() { return nullptr; }                                       // 5C
     virtual u16 getSizeAnmTbl() { return 0; }                                                       // 60
+#ifdef __MWERKS__
     virtual GeoObjSupervisor *getSupervisor() { return nullptr; }                                   // 64
+#else
+    // Subclasses declare a static getSupervisor() alongside the virtual one, which only MWCC accepts
+    GeoObjSupervisor *getSupervisor() { return getSupervisorVirtual(); }
+    virtual GeoObjSupervisor *getSupervisorVirtual() { return nullptr; }
+#endif
     virtual void getItemThrowDirPow(JGeometry::TVec3f *, f32 *, const ItemObj &);                   // 68
     virtual void getKartThrowDirPow(JGeometry::TVec3f *, f32 *, int);                               // 6C
     virtual void makeSharedDL() {                                                                   // 70
