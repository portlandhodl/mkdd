Access control that MWCC does not enforce. Race2D, NetGameMgr and the
scene classes read private statics of other classes, and RivalSpeedCtrl
callers use RivalCtrlBase members through a private base; clang rejects
both, so the host build adds the friend declarations and makes the base
protected.

--- a/include/Inagaki/GameAudioMain.h
+++ b/include/Inagaki/GameAudioMain.h
@@ -14,6 +14,7 @@
 class CrsArea;
 class JASAudioReseter;
 class JAISoundHandles;
+class Race2D;
 
 namespace GameAudio {
 
@@ -143,6 +144,8 @@
     };
 
 private:
+    friend class ::Race2D;
+
     static Main *msBasic;
 
     CustomMgr *mMgr;              // 00
--- a/include/Osako/AppMgr.h
+++ b/include/Osako/AppMgr.h
@@ -47,6 +47,10 @@
     static void restartCurrentApp() { msRequest |= REQUEST_RESTART; }
 
 private:
+    friend class NetGameMgr;
+    friend class SceneCourseSelect;
+    friend class SceneTitle;
+
     static KartAppEnum msGameApp;
     static KartAppEnum msNextGameApp;
     static KartAppEnum msNextNextGameApp;
--- a/include/Osako/Kart2DCommon.h
+++ b/include/Osako/Kart2DCommon.h
@@ -59,6 +59,8 @@
 
     static Kart2DCommon *ptr() { return mspKart2DCommon; }
 private:
